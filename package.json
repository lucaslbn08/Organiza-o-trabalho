{
  "name": "workspace",
  "productName": "Workspace",
  "version": "0.4.0",
  "description": "Workspace — organização pessoal offline para Windows",
  "main": "dist/main/main/index.js",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "npm run assets && npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run assets && npm run build:main && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "rebuild:electron": "electron-builder install-app-deps",
    "dist:win": "npm run build && electron-builder --win nsis",
    "postinstall": "echo \"Para rodar no Electron execute: npm run rebuild:electron\"",
    "assets": "node scripts/copy-assets.mjs"
  },
  "build": {
    "appId": "br.local.workspace",
    "productName": "Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "perMachine": false
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@tiptap/extension-highlight": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text-style": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.74.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
